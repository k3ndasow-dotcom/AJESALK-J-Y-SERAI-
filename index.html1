<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#062F4F">
<title>J’Y SERAI — AJESALK × AKGN</title>
<style>
:root{
 --navy:#062F4F;--blue:#0B557F;--green:#087A32;--mint:#EAF5ED;
 --paper:#FAFCFA;--ink:#12241B;--muted:#617168;--border:#DCE7E0;
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;font-family:Arial,Helvetica,sans-serif;background:#edf2ef;color:var(--ink)}
body{padding:18px}
.shell{max-width:1080px;margin:auto;background:white;border-radius:28px;overflow:hidden;box-shadow:0 22px 70px rgba(6,47,79,.14);border:1px solid #e0e9e4}
.top{background:var(--navy);padding:22px 28px 19px;position:relative}
.top:after{content:"";position:absolute;left:0;right:0;bottom:0;height:6px;background:linear-gradient(90deg,var(--green),#55BE5B,var(--green))}
.logos{display:flex;align-items:center;justify-content:center;gap:28px}
.logos img{width:280px;height:78px;object-fit:contain}
.sep{width:1px;height:52px;background:rgba(255,255,255,.28);position:relative}
.sep:after{content:"×";position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);color:#9FE1A7;background:var(--navy);padding:4px;font-size:19px;font-weight:900}
.eyebrow{text-align:center;color:#BCEBC2;font-size:11px;font-weight:900;letter-spacing:3px;margin-top:10px}
.heading{padding:22px 24px 4px;text-align:center}
.heading h1{margin:0;color:var(--navy);font-size:clamp(25px,5vw,43px);line-height:1.02;letter-spacing:-1px}
.heading p{margin:10px auto 0;max-width:720px;color:var(--muted);font-size:15px;line-height:1.45}
.editor{margin:18px auto 22px;max-width:760px;padding:11px;background:#e9efeb;border:1px solid #d9e5dd;border-radius:25px}
.canvasBox{position:relative;width:100%}
canvas{display:block;width:100%;height:auto;border-radius:17px;box-shadow:0 14px 38px rgba(6,47,79,.20);touch-action:none;user-select:none;-webkit-user-select:none;cursor:move;background:#fff}
.toolbar{display:flex;justify-content:center;gap:9px;flex-wrap:wrap;padding:12px 4px 4px}
.upload,.btn{border:0;border-radius:12px;padding:12px 17px;font-size:14px;font-weight:900;cursor:pointer}
.upload{background:linear-gradient(135deg,#087A32,#45B649);color:#fff;box-shadow:0 7px 18px rgba(8,122,50,.22)}
.btn{background:var(--navy);color:#fff}
.help{margin:7px 3px 1px;text-align:center;font-size:12px;color:#64766c}
.form{max-width:760px;margin:auto;padding:0 20px 25px}
label{display:block;font-weight:900;color:var(--navy);font-size:14px;margin:8px 0}
input[type=text]{width:100%;border:2px solid var(--border);border-radius:13px;padding:15px 16px;font-size:17px;outline:none}
input[type=text]:focus{border-color:var(--green);box-shadow:0 0 0 4px rgba(8,122,50,.08)}
.check{display:flex;gap:10px;align-items:flex-start;margin:14px 0;padding:13px 14px;background:#f1f8f2;border:1px solid #cfe3d2;border-radius:13px;font-size:13px;line-height:1.4}
.check input{width:20px;height:20px;accent-color:var(--green);flex:none}
.primary{width:100%;border:0;border-radius:13px;padding:16px;background:linear-gradient(135deg,var(--navy),#0A527D);color:#fff;font-size:15px;font-weight:950;cursor:pointer;box-shadow:0 10px 25px rgba(6,47,79,.18)}
.note{text-align:center;font-size:11px;color:#7a8881;line-height:1.4}
#result{display:none;padding:0 20px 28px;text-align:center}
.actions{display:flex;justify-content:center;gap:9px;flex-wrap:wrap}
@media(max-width:650px){
 body{padding:6px}
 .shell{border-radius:20px}
 .top{padding:15px 10px 13px}
 .logos{gap:10px}
 .logos img{width:43%;height:55px}
 .sep{height:40px}
 .heading{padding:17px 14px 2px}
 .heading p{font-size:13px}
 .editor{margin:13px 7px 18px;padding:7px;border-radius:20px}
 .form{padding:0 14px 22px}
}
</style>
</head>
<body>
<div class="shell">
<header class="top">
 <div class="logos">
  <img src="data:image/jpeg;base64," alt="AJESALK">
  <div class="sep"></div>
  <img src="data:image/jpeg;base64," alt="AKGN">
 </div>
 <div class="eyebrow">SORTIE TOURISTIQUE • MERCREDI 02 SEPTEMBRE 2026</div>
</header>

<section class="heading">
 <h1>PERSONNALISEZ VOTRE<br>« J’Y SERAI ! »</h1>
 <p>Votre affiche est prête. Ajoutez votre photo et positionnez-la directement dans le cercle avec votre doigt.</p>
</section>

<section class="editor">
 <div class="canvasBox">
  <canvas id="canvas" width="1080" height="1350"></canvas>
 </div>
 <div class="toolbar">
  <label class="upload" for="photo">📷 AJOUTER MA PHOTO</label>
  <input id="photo" type="file" accept="image/*" hidden>
 </div>
 <div class="help">👆 Faites glisser la photo avec un doigt • 🤏 Pincez avec deux doigts pour zoomer</div>
</section>

<section class="form">
 <label for="name">Nom et prénom du participant</label>
 <input id="name" type="text" maxlength="50" placeholder="Ex. Mamadou Kenda SOW">
 <div class="check">
  <input id="agree" type="checkbox">
  <label for="agree" style="margin:0;color:#183326">Je m’engage à respecter les conditions de bonne conduite pendant toute la sortie.</label>
 </div>
 <button class="primary" id="generate">✓ VALIDER ET PRÉPARER MON VISUEL</button>
 <p class="note">La photo et le nom restent dans votre navigateur et ne sont pas envoyés à un serveur.</p>
</section>

<div id="result">
 <div class="actions">
  <button class="btn" id="download">📥 Enregistrer</button>
  <button class="btn" id="share">📤 Partager</button>
 </div>
</div>
</div>

<script>
const canvas=document.getElementById('canvas'),ctx=canvas.getContext('2d');
const photoInput=document.getElementById('photo'),nameInput=document.getElementById('name'),agree=document.getElementById('agree');
const al=new Image(),ak=new Image();al.src="data:image/jpeg;base64,";ak.src="data:image/jpeg;base64,";
let photoImg=null,photoZoom=1,photoX=0,photoY=0;
let pointers=new Map(),dragging=false,dragStartX=0,dragStartY=0,startX=0,startY=0,pinchStart=0,pinchZoom=1;

function rr(x,y,w,h,r,fill,stroke){
 ctx.beginPath();ctx.moveTo(x+r,y);ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);
 ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);ctx.closePath();
 if(fill){ctx.fillStyle=fill;ctx.fill()} if(stroke){ctx.strokeStyle=stroke;ctx.stroke()}
}
function fit(text,max){
 let s=52;while(s>18){ctx.font=`900 ${s}px Arial`;if(ctx.measureText(text).width<=max)return s;s-=2}return s;
}
function cover(img,cx,cy,size,zoom,x,y){
 const side=Math.min(img.width,img.height);
 const sx=(img.width-side)/2,sy=(img.height-side)/2;
 const d=size*zoom;
 ctx.drawImage(img,sx,sy,side,side,cx-d/2+x,cy-d/2+y,d,d);
}
function draw(){
 const bg=ctx.createLinearGradient(0,0,1080,1350);bg.addColorStop(0,'#FFFFFF');bg.addColorStop(1,'#EFF6F1');
 ctx.fillStyle=bg;ctx.fillRect(0,0,1080,1350);

 // header
 ctx.fillStyle='#062F4F';ctx.fillRect(0,0,1080,155);
 ctx.fillStyle='#087A32';ctx.fillRect(0,0,14,155);
 ctx.fillStyle='#45B649';ctx.fillRect(14,149,1052,6);
 if(al.complete)ctx.drawImage(al,52,28,300,96);
 if(ak.complete)ctx.drawImage(ak,728,28,300,96);
 ctx.fillStyle='rgba(255,255,255,.3)';ctx.fillRect(535,42,1,68);
 ctx.fillStyle='#BCEBC2';ctx.font='900 20px Arial';ctx.textAlign='center';ctx.fillText('×',540,82);

 // title
 ctx.textAlign='left';ctx.fillStyle='#087A32';ctx.font='900 24px Arial';ctx.fillText('SORTIE TOURISTIQUE',70,205);
 ctx.fillStyle='#062F4F';ctx.font='950 105px Arial';ctx.fillText('J’Y',70,315);
 ctx.fillStyle='#087A32';ctx.fillText('SERAI !',70,420);
 ctx.fillStyle='#45B649';ctx.fillRect(73,440,290,7);

 // date/location card
 rr(70,470,940,125,20,'#062F4F');
 ctx.fillStyle='#fff';ctx.textAlign='left';ctx.font='900 33px Arial';ctx.fillText('MERCREDI 02 SEPTEMBRE 2026',98,518);
 ctx.fillStyle='#BFE8C7';ctx.font='700 22px Arial';ctx.fillText('LONCING • MIELLERIE & MENUISERIE',98,555);
 ctx.fillStyle='#fff';ctx.font='700 22px Arial';ctx.fillText('FELLO-BHASSO • FORÊT COMMUNAUTAIRE',98,582);

 // participant panel
 rr(70,630,555,305,27,'#FFFFFF','#DCE7E0');
 ctx.fillStyle='#087A32';ctx.font='900 19px Arial';ctx.textAlign='left';ctx.fillText('PARTICIPANT',105,680);
 const n=nameInput.value.trim()||'VOTRE NOM ET PRÉNOM';
 const fs=fit(n,475);ctx.font=`900 ${fs}px Arial`;ctx.fillStyle=nameInput.value.trim()?'#062F4F':'#84938B';ctx.fillText(n,105,754);
 ctx.fillStyle='#E4EEE7';ctx.fillRect(105,782,455,3);
 ctx.fillStyle='#53695C';ctx.font='700 20px Arial';ctx.fillText('Une journée de découverte,',105,830);
 ctx.fillText('d’apprentissage et de valorisation',105,861);
 ctx.font='800 18px Arial';ctx.fillStyle='#087A32';ctx.fillText('de notre patrimoine local.',105,894);

 // photo circle
 const cx=800,cy=790,r=225;
 ctx.save();ctx.beginPath();ctx.arc(cx,cy,r,0,Math.PI*2);ctx.clip();
 if(photoImg)cover(photoImg,cx,cy,450,photoZoom,photoX,photoY);
 else{
  const ph=ctx.createLinearGradient(cx-r,cy-r,cx+r,cy+r);ph.addColorStop(0,'#E7F1EA');ph.addColorStop(1,'#D2E3D8');
  ctx.fillStyle=ph;ctx.fillRect(cx-r,cy-r,2*r,2*r);
  ctx.fillStyle='#062F4F';ctx.textAlign='center';ctx.font='900 32px Arial';ctx.fillText('VOTRE PHOTO',cx,cy-6);
  ctx.fillStyle='#5C7165';ctx.font='700 21px Arial';ctx.fillText('Ajoutez-la ici',cx,cy+31);
 }
 ctx.restore();
 ctx.lineWidth=16;ctx.strokeStyle='#fff';ctx.beginPath();ctx.arc(cx,cy,r+1,0,Math.PI*2);ctx.stroke();
 ctx.lineWidth=7;ctx.strokeStyle='#087A32';ctx.beginPath();ctx.arc(cx,cy,r+17,0,Math.PI*2);ctx.stroke();

 rr(630,1038,340,55,28,'#062F4F');
 ctx.fillStyle='#fff';ctx.textAlign='center';ctx.font='900 18px Arial';ctx.fillText(photoImg?'GLISSEZ POUR AJUSTER':'PHOTO DU PARTICIPANT',800,1073);

 // footer
 ctx.fillStyle='#062F4F';ctx.font='900 24px Arial';ctx.fillText('DÉCOUVRIR • APPRENDRE • VALORISER • PRÉSERVER',540,1175);
 ctx.fillStyle='#087A32';ctx.font='950 28px Arial';ctx.fillText('AJESALK × AKGN',540,1223);
 ctx.fillStyle='#607168';ctx.font='600 18px Arial';ctx.fillText('Éducation • Patrimoine • Développement durable',540,1260);
 ctx.fillStyle='#062F4F';ctx.font='800 17px Arial';ctx.fillText('J’Y SERAI — SORTIE DU 02 SEPTEMBRE 2026',540,1301);
 ctx.fillStyle='#45B649';ctx.fillRect(70,1323,940,6);
}
function pos(e){
 const r=canvas.getBoundingClientRect();return {x:(e.clientX-r.left)*1080/r.width,y:(e.clientY-r.top)*1350/r.height};
}
function distance(a,b){return Math.hypot(a.x-b.x,a.y-b.y)}
canvas.addEventListener('pointerdown',e=>{
 if(!photoImg)return;
 const p=pos(e);pointers.set(e.pointerId,p);canvas.setPointerCapture(e.pointerId);
 if(pointers.size===1 && Math.hypot(p.x-800,p.y-790)<250){
  dragging=true;dragStartX=p.x;dragStartY=p.y;startX=photoX;startY=photoY;
 }else if(pointers.size===2){
  const a=[...pointers.values()];pinchStart=distance(a[0],a[1]);pinchZoom=photoZoom;dragging=false;
 }
});
canvas.addEventListener('pointermove',e=>{
 if(!pointers.has(e.pointerId))return;pointers.set(e.pointerId,pos(e));
 if(pointers.size===1&&dragging){
  const p=pointers.get(e.pointerId);photoX=startX+p.x-dragStartX;photoY=startY+p.y-dragStartY;draw();
 }else if(pointers.size===2&&pinchStart){
  const a=[...pointers.values()];photoZoom=Math.max(.7,Math.min(2.7,pinchZoom*distance(a[0],a[1])/pinchStart));draw();
 }
});
function end(e){pointers.delete(e.pointerId);if(pointers.size<2)pinchStart=0;if(!pointers.size)dragging=false}
canvas.addEventListener('pointerup',end);canvas.addEventListener('pointercancel',end);

photoInput.addEventListener('change',()=>{
 const f=photoInput.files[0];if(!f)return;const r=new FileReader();
 r.onload=e=>{photoImg=new Image();photoImg.onload=()=>{photoZoom=1;photoX=0;photoY=0;draw()};photoImg.src=e.target.result};
 r.readAsDataURL(f);
});
nameInput.addEventListener('input',draw);
document.getElementById('generate').onclick=()=>{
 if(!nameInput.value.trim()){alert('Veuillez saisir votre nom et prénom.');nameInput.focus();return}
 if(!photoImg){alert('Veuillez ajouter votre photo.');return}
 if(!agree.checked){alert('Veuillez cocher votre engagement de bonne conduite.');return}
 draw();document.getElementById('result').style.display='block';document.getElementById('result').scrollIntoView({behavior:'smooth'});
};
document.getElementById('download').onclick=()=>{
 const a=document.createElement('a');a.download='JY-SERAI-'+(nameInput.value.trim().replace(/\s+/g,'-')||'participant')+'.png';a.href=canvas.toDataURL('image/png');a.click();
};
document.getElementById('share').onclick=()=>canvas.toBlob(async blob=>{
 const file=new File([blob],'JY-SERAI.png',{type:'image/png'});
 if(navigator.canShare&&navigator.canShare({files:[file]}))await navigator.share({title:'J’Y SERAI !',text:'Je serai à la sortie touristique du 02 septembre 2026.',files:[file]});
 else alert('Le partage direct n’est pas disponible sur ce navigateur. Enregistrez le visuel puis partagez-le.');
},'image/png');

Promise.all([
 new Promise(r=>al.complete?r():al.onload=r),
 new Promise(r=>ak.complete?r():ak.onload=r)
]).then(draw);
</script>
</body>
</html>